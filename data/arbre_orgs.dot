    "leg8" [label="social-démocrate", fillcolor="#e84393", fontcolor="white"];
    "leg9" [label="écologiste", fillcolor="#58d68d", fontcolor="black"];
    "leg10" [label="autre / inconnu", fillcolor="#d5d8dc", fontcolor="black"];
    "leg_e" [label="organisation étrangère", fillcolor="#ffffff", fontcolor="#000000", style="filled,rounded,dashed", penwidth=2, color="#000000"];
    "leg_i" [label="Internationale (organisation parente)", fillcolor="#ffffff", fontcolor="#000000", peripheries=2, penwidth=1.5, color="#333333"];
